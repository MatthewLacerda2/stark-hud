#!/usr/bin/env bash
#
# Everything, before anything leaves this machine.
#
# There is no CI, so this is the last thing between a mistake and master. It
# costs about forty-five seconds and is meant to: pushing is rare, and the
# alternative is finding out from the television.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Nothing to check when nothing is going up. git reports a deletion as an
# all-zero local sha, and running the full gate to tidy away a merged branch is
# forty-five seconds spent on no code at all — which is how you teach somebody
# that --no-verify is the fast way to do housekeeping.
deleting=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    case "$local_sha" in
        *[!0]*) deleting=false ;;
    esac
done
$deleting && exit 0

exec make --no-print-directory check
