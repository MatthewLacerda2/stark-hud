# Copy to .env and adjust. Never commit the real .env.
#
# There is no database and no auth: the board is open to anyone on the LAN by
# design, and is kept in a single file rather than in a database.

# The grid. Fixed and never scrolls, because the TV cannot scroll.
GRID_COLS=32
GRID_ROWS=18

# Where the board is kept between runs. Empty means keep nothing.
STATE_FILE=state/board.hud
# How long the board may be ahead of the file on disk.
STATE_FLUSH_SECONDS=5

# Bind address. 0.0.0.0 is deliberate: the whole point is LAN access.
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * to allow any).
CORS_ORIGINS=*

# The board's voice (ElevenLabs). Left empty here on purpose — this file is
# tracked. Put the real key in .env, which git ignores; without one the board
# works exactly as before and simply cannot speak.
ELEVENLABS_API_KEY=
# Where a spoken line is kept until the browser has fetched it, and how many
# are kept before the oldest are deleted.
SPEECH_DIR=state/speech
SPEECH_KEEP=20
